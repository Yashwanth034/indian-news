{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yashwanth034/indian-news/config/schemas/categories.schema.json",
  "title": "India News categories",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "label", "description", "importance_weight",
          "urgent", "default_cap_per_day", "terms"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "importance_weight": {"type": "number", "minimum": 0, "maximum": 10},
          "urgent": {"type": "boolean"},
          "default_cap_per_day": {"type": "integer", "minimum": 0},
          "terms": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
